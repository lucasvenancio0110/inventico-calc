{
  "name": "inventico-calc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "ai:serve": "node --env-file-if-exists=.env server/index.ts",
    "dev": "vite --host localhost --port 5173 --strictPort",
