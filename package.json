    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
