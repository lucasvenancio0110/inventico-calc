{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inventico",
  "account_id": "9e6808e70e268143f4dc35146b46666c",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "AI_BUDGET", "class_name": "AIBudget" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AIBudget"] }],
  "vars": {
    "OPENAI_IMAGE_MODEL": "gpt-image-2",
    "OPENAI_VISION_MODEL": "gpt-4.1",
    "INVENTICO_ALLOWED_ORIGINS": "https://inventico.lucassantanals0110.workers.dev,http://localhost:8787",
    "INVENTICO_MAX_CALLS": "10",
    "INVENTICO_BUDGET_PERIOD": "initial",
  },
  "observability": { "enabled": false },
}
